<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- mpv embeds LuaJIT (MPVKit's Libluajit), which compiles to machine
	     code at run time. Under the hardened runtime that needs MAP_JIT. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
