    "Add an M3U URL or an Xtream Codes provider. Channels then show up in Live and in search.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une URL M3U ou un fournisseur Xtream Codes. Les chaînes apparaissent ensuite dans Direct."
          }
        }
      }
    },
    "Add an M3U playlist URL to tune in. Xtream providers and local files are supported — credentials never leave this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'URL d'une playlist M3U pour commencer. Les fournisseurs Xtream et les fichiers locaux sont pris en charge — vos identifiants ne quittent jamais cet appareil."
          }
        }
      }
    },
